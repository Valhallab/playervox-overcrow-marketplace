{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overcrow.playervox.com/schemas/widget-listing-v1.json",
  "title": "OverCrow widget listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["author", "spdxLicense", "sourceUrl", "localizations"],
  "properties": {
    "author": {"type": "string", "minLength": 1, "maxLength": 128},
    "spdxLicense": {"type": "string", "minLength": 1, "maxLength": 64},
    "sourceUrl": {"type": "string", "format": "uri", "maxLength": 2048},
    "localizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "name", "description"],
        "properties": {
          "locale": {"type": "string", "minLength": 2, "maxLength": 35},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "previewFile": {
      "type": "string",
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*[.]png$"
    }
  }
}
