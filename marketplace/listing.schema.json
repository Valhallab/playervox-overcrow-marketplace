{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overcrow.playervox.com/schemas/widget-listing-v1.json",
  "title": "OverCrow widget listing",
  "$comment": "String limits mirror runtime UTF-8 byte limits; JSON Schema maxLength counts characters, so the Rust policy validator remains authoritative for multibyte text, URL canonicalization, and unique locale IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["author", "spdxLicense", "sourceUrl", "localizations"],
  "properties": {
    "author": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\s)(?!.*[<>\\u0000-\\u001F\\u007F])(?!.*\\s$).+$"},
    "spdxLicense": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"},
    "sourceUrl": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[A-Za-z0-9.-]+/(?:[^/\\\\%?#]+/)*[^/\\\\%?#]+$"},
    "localizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "name", "description"],
        "properties": {
          "locale": {"type": "string", "minLength": 2, "maxLength": 5, "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\s)(?!.*[<>\\u0000-\\u001F\\u007F])(?!.*\\s$).+$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!\\s)(?!.*[<>\\u0000-\\u001F\\u007F])(?!.*\\s$).+$"}
        }
      }
    },
    "previewFile": {
      "type": "string",
      "maxLength": 192,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.png$"
    }
  }
}
